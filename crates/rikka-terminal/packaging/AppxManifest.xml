<?xml version="1.0" encoding="utf-8"?>
<!--
  RikkaTerminal — sparse (external-location) package manifest.

  PURPOSE (P1 = "UI registration"): make RikkaTerminal appear as a selectable
  entry in the Windows 11 "Default terminal application" dropdown, WITHOUT
  putting rt.exe inside an MSIX and WITHOUT changing the active default
  (HKCU\Console\%%Startup is untouched — installing this only ADDS a candidate).

  HOW IT WORKS (verified against microsoft/terminal Package.appxmanifest):
  Windows enumerates the dropdown from two well-known windows.appExtension
  entries — "com.microsoft.windows.console.host" and
  "com.microsoft.windows.terminal.host" — each carrying a <Clsid>. The
  DisplayName is what shows in the dropdown. The com:Extension below maps those
  CLSIDs to executables (console side reuses our vendored OpenConsole.exe; the
  terminal side is our own rikka-handoff.exe stub).

  EXTERNAL LOCATION: this package carries NO binaries. rt.exe, OpenConsole.exe
  and rikka-handoff.exe all live in the normal (unpackaged) install dir, which
  is supplied at install time via `Add-AppxPackage -ExternalLocation <dir>`.
  uap10:AllowExternalContent=true is what permits that. So rt stays a plain exe.

  BEFORE PACKING — replace the three REPLACE_ME markers:
    * Publisher  : MUST exactly match the subject of your signing cert
                   (self-signed for local testing).
    * two CLSIDs : generate fresh with `[guid]::NewGuid()` — do NOT reuse WT's.
  The two GUIDs below are random placeholders; regenerate your own.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 com desktop rescap">

  <Identity
    Name="RikkaTerminal"
    Publisher="CN=sousuke0422"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>RikkaTerminal</DisplayName>
    <PublisherDisplayName>sousuke0422 and contributors</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <!-- Permits the external-location install (binaries stay unpackaged). -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <!-- Floor = Win10 2004 (19041), the sparse external-location minimum
         (AllowExternalContent). The default-terminal handoff also works on
         Windows 10 too — confirmed on 19045 (Win10 22H2), where RikkaTerminal
         lists in Settings > For developers AND Windows Terminal's Startup
         dropdown (P1 verified on-device). -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="rikka-terminal.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="RikkaTerminal"
        Description="RikkaTerminal"
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png" />

      <Extensions>
        <!-- ① Console-host provider (IConsoleHandoff). The console CLSID is
             bound to whatever OpenConsole.exe registers at -Embedding time,
             and OpenConsole bakes that CLSID per branding (WT Stable
             {2EACA947...}, Preview {06EC847C...}, Dev {1F9F2BF5...}).
             VERIFIED 2026-07-12: our vendored ConPTY OpenConsole is a
             Stable-branding build WITH the defterm role compiled in — so it
             would answer as {2EACA947...} and collide with an installed WT.
             Resolution: the install script patches the DEPLOYED copy's two
             .rdata GUID constants to the fresh CLSID below (vendored asset
             stays pristine), making this pair fully live for Settings-UI
             selection. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.microsoft.windows.console.host"
            Id="RikkaConsoleHost"
            DisplayName="RikkaTerminal"
            Description="RikkaTerminal console host"
            PublicFolder="Public">
            <uap3:Properties>
              <Clsid>{77F531BA-46BD-4E80-B0DF-8E45E1F7183B}</Clsid> <!-- minted 2026-07-12 ([guid]::NewGuid) -->
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>

        <!-- ② Terminal provider (ITerminalHandoff3). This is what shows in the
             dropdown as "RikkaTerminal" and receives EstablishPtyHandoff. In
             P1 the target exe (rikka-handoff.exe) is a stub; P2 makes it relay
             to the running rt main over the shared pipe. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.microsoft.windows.terminal.host"
            Id="RikkaTerminalHost"
            DisplayName="Rikka Terminal"
            Description="Rikka Terminal"
            PublicFolder="Public">
            <uap3:Properties>
              <Clsid>{0DA1B045-A599-4133-A9EE-A7A3893E1D62}</Clsid> <!-- minted 2026-07-12; must match CLSID_RIKKA_TERMINAL_HANDOFF in rikka-terminal-windows-integration -->
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>

        <!-- CLSID -> executable mapping. NOTE (confirm on a Win11 build):
             WT's manifest declares the appExtensions above; whether this
             com:Extension is strictly required or the FullTrust exe can
             self-register its class factory at runtime (-Embedding) needs
             device verification. Included here as the explicit, safe form. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="OpenConsole.exe" DisplayName="RikkaTerminal Console Host">
              <com:Class Id="77F531BA-46BD-4E80-B0DF-8E45E1F7183B" />
            </com:ExeServer>
            <com:ExeServer Executable="rikka-handoff.exe" DisplayName="RikkaTerminal" Arguments="-Embedding">
              <com:Class Id="0DA1B045-A599-4133-A9EE-A7A3893E1D62" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
